# Groq — free LLM + Whisper (one account, one key) — https://console.groq.com
GROQ_API_KEY=

# YouTube cookies — base64-encoded Netscape cookies.txt
# Real file lives OUTSIDE the repo (e.g. D:\Developer\secrets\cookies.txt), never committed.
# Encode with: [Convert]::ToBase64String([IO.File]::ReadAllBytes("D:\Developer\secrets\cookies.txt"))
# Paste the single-line base64 into Vercel env var YT_COOKIES_B64
YT_COOKIES_B64=

# Optional overrides (only if you need them later)
# VITE_API_BASE_URL=https://your-api.vercel.app
# YTDLP_PATH=
# FFMPEG_PATH=
