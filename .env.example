# Frontend (Vercel) — set as Vercel Environment Variable
# Point to your live Render backend URL (e.g. https://creatorflow-ai-backend.onrender.com)
VITE_API_BASE_URL=

# Backend env vars are NOT set in Vercel — set them on Render dashboard instead.
# See server/.env.example for the full list:
#   COOKIES_TXT_BASE64 — single-line base64 of your Netscape cookies.txt
#   GROQ_API_KEY       — from https://console.groq.com
#   FRONTEND_ORIGIN    — your Vercel URL (e.g. https://creatorflow-ai.vercel.app)
# Legacy name for the same cookie var (still accepted by backend):
# YT_COOKIES_B64=  (alias for COOKIES_TXT_BASE64, prefer the new name)
