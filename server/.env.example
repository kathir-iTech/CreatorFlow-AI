# CreatorFlow AI — Render backend env template
# Copy to server/.env for local dev (never commit .env itself — gitignored)

# Core
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# CORS — production: set FRONTEND_ORIGIN to your Vercel URL (e.g. https://creatorflow-ai.vercel.app)
# Local dev can keep CORS_ORIGINS=* or set FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=*
FRONTEND_ORIGIN=
# Example: FRONTEND_ORIGIN=https://creatorflow-ai.vercel.app

# YouTube cookies — paste single-line base64 of your Netscape cookies.txt
# Generate: [Convert]::ToBase64String([IO.File]::ReadAllBytes("D:\Developer\secrets\cookies.txt"))
COOKIES_TXT_BASE64=
# Alternative raw (not recommended for Render): COOKIES_TXT=

# Groq — free LLM + Whisper (one key) https://console.groq.com
GROQ_API_KEY=
# Optional: override the SEO chat model (default: openai/gpt-oss-120b,
# Groq's replacement for the retired llama-3.3-70b-versatile)
# GROQ_SEO_MODEL=openai/gpt-oss-120b

# Optional: per-provider cookies (if Instagram/Facebook need separate sessions)
# INSTAGRAM_COOKIES_TXT_BASE64=
# FACEBOOK_COOKIES_TXT_BASE64=

# Optional: outbound proxy for yt-dlp (e.g. socks5:// or http://user:pass@host:port)
# PROXY_URL=

# Optional: YouTube hardening (server-only, never expose to frontend)
# YOUTUBE_USER_AGENT=
# YOUTUBE_VISITOR_DATA=
# YOUTUBE_PO_TOKEN=
# YOUTUBE_GETPOT_BASE_URL=http://localhost:4416

# Limits
TMP_DIR=./tmp
MAX_CONCURRENT_DOWNLOADS=5
MAX_FILE_SIZE_MB=2048
JOB_TIMEOUT_MS=600000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Cache
METADATA_CACHE_TTL_MS=600000
METADATA_CACHE_MAX=500
